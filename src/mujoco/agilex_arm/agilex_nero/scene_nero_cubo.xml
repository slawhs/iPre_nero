<!--
  scene_nero_cubo.xml
  ===================
  Escena del grupo 2 para las preguntas 2 y 3 de la tarea: brazo Nero + un cubo
  movil de 4 cm con articulacion libre.

  Es identica a scene_nero_arm.xml salvo por el body "cubo_movil". Se mantiene
  como archivo aparte para no contaminar las escenas base del repositorio.

  Nombres que esperan los nodos de grupo2_pkg y el puente mujoco_viewer.py:
    - body  "cubo_movil"  (posicion del cubo)
    - joint "cubo_free"   (se impone qpos/qvel para moverlo)
    - geom  "cubo_tarea"  (deteccion de contacto con los dedos del gripper)

  Uso:
    ros2 launch nero_ctrl nero_can_ctrl.launch.py mode:=sim scene:=scene_nero_cubo.xml
-->
<mujoco model="nero_scene_cubo">
  <include file="nero_arm.xml"/>

  <statistic center="0 0 0.1" extent="0.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Cubo movil de 4 cm.
         Viaja a la altura de una cinta transportadora (z = 0.12) cruzando en Y
         por delante del robot, para que la pinza no tenga que bajar al suelo.
         gravcomp="1" compensa su peso: hace de cinta sin dibujarla, de modo que
         el cubo no cae cuando el puente no le esta imponiendo la trayectoria
         (al arrancar la simulacion y despues del contacto). Quitalo si quieres
         que el cubo caiga de verdad. -->
    <body name="cubo_movil" pos="-0.55 0.0 0.12" gravcomp="1">

      <freejoint name="cubo_free"/>

      <geom name="cubo_tarea"
            type="box"
            size="0.02 0.02 0.02"
            mass="0.02"
            friction="1.5 0.005 0.0001"
            rgba="1 0.2 0.2 1"
            contype="1"
            conaffinity="1"/>

    </body>

    <!-- P4: sensor de proximidad simulado -> /proximity (scripts/sim_proximity.py).
         Mide a lo largo del eje +Z del site, aqui +Y: la direccion de avance del cubo.
         y_cubo = -0.90 + range + 0.02. Se reubica cambiando pos/zaxis. -->
    <body name="proximity_sensor" pos="-0.55 -0.90 0.12" zaxis="0 1 0">
      <geom name="proximity_housing" type="box" size="0.022 0.01 0.008"
            pos="0 0 -0.009" rgba="0.1 0.4 0.9 1" contype="0" conaffinity="0" mass="0.01"/>
      <site name="proximity_site" size="0.004" rgba="1 1 0 1"/>
    </body>

  </worldbody>
</mujoco>
